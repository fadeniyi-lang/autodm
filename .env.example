# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openreply
REDIS_URL=redis://localhost:6379

# Email for password resets (optional; Resend, or EMAIL_SERVER below)
RESEND_API_KEY=re_...
EMAIL_FROM=AutoDM <login@example.com>

# Optional: restrict who can sign in. Without it, anyone who reaches your
# public URL can request a magic link and gets their own workspace. Comma
# separated, case insensitive.
# ALLOWED_EMAILS=you@example.com,teammate@example.com

# Optional: use your own SMTP server instead of Resend. When EMAIL_SERVER is
# set it takes over and RESEND_API_KEY is not needed. URL-encode special
# characters in user and password (@ becomes %40).
# EMAIL_SERVER=smtps://login%40example.com:password@mail.example.com:465

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token

# Optional: an owner login that works from the very first boot, with no
# sign-up step. Pair it with ALLOWED_EMAILS set to the same address.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional: reword each DM and public reply in your voice with Claude before it
# sends (worker only). Falls back to your template on any error.
# AI_VOICE_REPLIES=true
# ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_MODEL=claude-haiku-4-5
# AI_VOICE_GUIDE=Warm, direct, short sentences. Uses contractions.

# Optional: comma-separated hostnames allowed to submit forms, only needed
# behind a proxy that rewrites the Host header.
# SERVER_ACTIONS_ALLOWED_ORIGINS=autodm.example.com

# Cron service only (Dockerfile.cron): where the web app lives.
# CRON_BASE_URL=https://autodm.example.com
